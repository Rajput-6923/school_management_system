# Copy this file to server/.env and replace the placeholders with your own local values.
# Never commit server/.env or put database credentials in VITE_* variables.
DATABASE_URL=postgresql://eduflow_user:replace_with_your_database_password@localhost:5432/eduflow

# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Used only by `npm run db:create-admin`; remove ADMIN_PASSWORD after account creation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
ADMIN_NAME=School Administrator
